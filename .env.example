# =============================================================================
# Liberty Roleplay — environment variables
# Copy to `.env` (and `.env.local` for the web app) and fill in real values.
# Every variable here is validated at startup by a zod schema; a missing or
# malformed value fails fast rather than at runtime in production.
# Nothing real is ever committed — only this example file is tracked.
# =============================================================================

# --- Site ---------------------------------------------------------------------
# Public base URL of the deployed web app (no trailing slash). Used for
# absolute URLs in metadata, sitemap, robots and OG images.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Database (Neon / Postgres) ----------------------------------------------
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# --- Auth.js v5 + Discord OAuth (M3) -----------------------------------------
AUTH_SECRET=
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=
NEXTAUTH_URL=http://localhost:3000

# --- Discord bot (M6) ---------------------------------------------------------
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_STAFF_CHANNEL_ID=
DISCORD_VERIFIED_ROLE_ID=
BOT_WEBHOOK_URL=            # web -> bot
BOT_WEBHOOK_SECRET=         # shared HMAC secret, both directions
WEB_WEBHOOK_URL=            # bot -> web

# --- Stripe (M10) -------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Email (Resend) -----------------------------------------------------------
RESEND_API_KEY=

# --- Media (Vercel Blob / UploadThing / Cloudinary) --------------------------
BLOB_READ_WRITE_TOKEN=

# --- Spam protection (Cloudflare Turnstile) ----------------------------------
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# --- Redis (Upstash — rate limiting + bot jobs) ------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Map (if using Mapbox; Path B) -------------------------------------------
NEXT_PUBLIC_MAPBOX_TOKEN=

# --- Observability (Sentry) --------------------------------------------------
SENTRY_DSN=
