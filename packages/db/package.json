{
  "name": "@liberty/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts",
    "./client": "./src/client.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "generate": "drizzle-kit generate",
    "migrate": "drizzle-kit migrate",
    "push": "drizzle-kit push",
    "studio": "drizzle-kit studio",
    "seed": "tsx src/seed.ts",
    "clean": "rm -rf .turbo dist"
  },
  "dependencies": {
    "@liberty/shared": "workspace:*",
    "drizzle-orm": "0.45.2",
    "postgres": "3.4.9"
  },
  "devDependencies": {
    "@liberty/config": "workspace:*",
    "@types/node": "26.0.1",
    "drizzle-kit": "0.31.10",
    "tsx": "4.22.4",
    "typescript": "6.0.3"
  }
}
